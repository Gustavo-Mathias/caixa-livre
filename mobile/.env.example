# Copie para .env e preencha. Nada aqui é segredo: o app embute estes valores.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# RevenueCat (assinaturas). Chaves públicas de cada loja.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Páginas públicas exigidas pelas lojas
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=

# Só em desenvolvimento: dados de demonstração em memória, sem servidor.
# EXPO_PUBLIC_MOCK=1
# Só ligue quando o assistente com IA existir de verdade (aparece o plano de R$ 29,90).
# EXPO_PUBLIC_AI_ENABLED=1
